# Python bytecode and native build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging/build outputs
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environments and secrets
.env
.env.*
!.env.example
.venv/
venv/
ENV/
env.bak/
venv.bak/

# Notebook checkpoints and caches
.ipynb_checkpoints/
*.cache
labels.cache

# Editors and operating system files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Model weights are large; keep them out of ordinary Git history.
*.pt
*.pth
*.onnx
*.engine
!src/Models/.gitkeep

# Datasets and exported archives
Training/training.zip
Training/*.zip
Training/Dataset/train/
Training/Dataset/valid/
Training/Dataset/test/

# Inference caches (can be regenerated)
Stubs/*.pkl
!Stubs/.gitkeep

# Input videos are not needed in the GitHub repository.
Inputs/*.mp4
Inputs/*.avi
Inputs/*.mov
Inputs/*.mkv
!Inputs/.gitkeep

# Keep generated result videos/images in Git so they can be viewed/downloaded.
# GitHub's normal per-file limit is 100 MB; use Git LFS for larger media.
!Outputs/
!Outputs/*.mp4
!Outputs/*.avi
!Outputs/*.mov
!Outputs/*.mkv
!Outputs/*.png
!Outputs/*.jpg
!Outputs/*.jpeg
!Outputs/.gitkeep
