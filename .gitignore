*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Model weights (Large files)
*.pt
*.pth
*.onnx
*.engine
Models/*.pt
Training/*.pt
!Models/.gitkeep

# Dataset & Label caches (Roboflow / YOLO format)
Training/Dataset/train/
Training/Dataset/valid/
Training/Dataset/test/
*.cache
labels.cache

# Video and Media files (Heavy files)
Inputs/*.mp4
Inputs/*.avi
Inputs/*.mov
Outputs/*.mp4
Outputs/*.avi
Outputs/*.mov
!Inputs/.gitkeep
!Outputs/.gitkeep

# Pickled cache / Stubs (can be re-generated or large)
Stubs/*.pkl
!Stubs/.gitkeep
