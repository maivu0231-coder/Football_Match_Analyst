
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Model weights (Large files)
*.pt
*.pth
*.onnx
*.engine
Models/*.pt
Training/*.pt
!Models/.gitkeep

# Dataset & Label caches (Roboflow / YOLO format)
Training/training.zip
Training/*.zip
Training/Dataset/train/
Training/Dataset/valid/
Training/Dataset/test/
*.cache
labels.cache

# Input videos - DO NOT PUSH
Inputs/*.mp4
Inputs/*.avi
Inputs/*.mov
Inputs/*.mkv
!Inputs/.gitkeep

# Output videos - ALLOWED TO PUSH
# Do not add ignore rules for Outputs video files
!Outputs/
!Outputs/*.mp4
!Outputs/*.avi
!Outputs/*.mov
!Outputs/*.mkv
!Outputs/.gitkeep

# Pickled cache / Stubs
Stubs/*.pkl
!Stubs/.gitkeep
